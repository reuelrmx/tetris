{
  "name": "strata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "STRATA - a falling-block puzzle game (TypeScript, Canvas 2D, offline-first, WebSocket versus)",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:host": "vitest run test/host",
    "test:net": "vitest run test/net",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "server:dev": "node --watch server/src/index.ts",
    "server:start": "node server/src/index.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
